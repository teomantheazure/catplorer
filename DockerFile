FROM php:8.2-apache

# Gerekli eklentileri kur (curl, JSONBin bağlantısı için şart)
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    && docker-php-ext-install curl

# Oyun API dosyalarını kopyala
COPY api/ /var/www/html/

# Apache'nin varsayılan portunu aç
EXPOSE 80